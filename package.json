{
  "name": "griidai-local",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "start": "node cms-server.cjs",
    "env:local": "node scripts/init-env.cjs",
    "build:data": "node scripts/build-hubs.cjs --data-only",
    "build:content": "node scripts/build-hubs.cjs",
    "build:pages": "node scripts/build-hubs.cjs && node scripts/build-pages.cjs",
    "start:static": "node server.cjs",
    "test": "node --test tests/*.test.cjs"
  },
  "engines": {
    "node": ">=18"
  }
}
