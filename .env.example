# Server configuration. Copy to .env; never commit the real .env.
HOST=127.0.0.1
PORT=3000
SITE_URL=http://localhost:3000
STRAPI_URL=http://127.0.0.1:1337
STRAPI_PUBLIC_URL=http://localhost:1337
# Private, read-only Content API token (Blog and Use Case find/findOne permissions).
STRAPI_API_TOKEN=
# Same random secret in cms/.env. Minimum 32 random bytes recommended.
PREVIEW_SECRET=
# Public pricing URL remains independent of the CMS integration.
PRICING_EMBED_URL=https://api.griidai.com/api/v1/public/pricing/embed?mode=public
